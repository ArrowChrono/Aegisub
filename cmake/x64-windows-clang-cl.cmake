include("${CMAKE_CURRENT_LIST_DIR}/x64-windows-release.cmake")
set(VCPKG_DISABLE_COMPILER_TRACKING OFF)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/clang-cl-toolchain.cmake")
