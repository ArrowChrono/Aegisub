{
  "version": 1,
  "name": "subtitle-grid-join-line-breaks",
  "hosts": ["gui-test"],
  "load_global_scripts": false,
  "default_timeout_ms": 5000,
  "steps": [
    { "action": "command", "id": "am/reload/autoload" },
    { "action": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Prepare" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Single selection", "field": "validated", "equals": true },
    { "action": "assert", "target": "command", "id": "edit/line/join/with_line_breaks", "field": "validated", "equals": false },
    { "action": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Select input" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Input selection", "field": "validated", "equals": true },
    { "action": "assert", "target": "command", "id": "edit/line/join/with_line_breaks", "field": "validated", "equals": true },
    { "action": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Record prepared" },
    { "action": "command", "id": "edit/line/join/with_line_breaks" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Joined line breaks", "field": "validated", "equals": true },
    { "action": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Record line breaks" },
    { "action": "assert", "target": "command", "id": "edit/line/join/with_line_breaks", "field": "validated", "equals": false },
    { "action": "command", "id": "edit/undo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Original after undo", "field": "validated", "equals": true },
    { "action": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Record undo" },
    { "action": "command", "id": "edit/redo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Joined line breaks", "field": "validated", "equals": true },
    { "action": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Record redo" },
    { "action": "command", "id": "edit/undo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Original after undo", "field": "validated", "equals": true },
    { "action": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Select input" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Input selection", "field": "validated", "equals": true },
    { "action": "command", "id": "edit/line/join/concatenate" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Joined spaces", "field": "validated", "equals": true },
    { "action": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Record concatenate" },
    { "action": "command", "id": "edit/undo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Original after undo", "field": "validated", "equals": true },
    { "action": "command", "id": "edit/undo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Initial document restored", "field": "validated", "equals": true },
    { "action": "assert", "target": "command", "id": "edit/undo", "field": "validated", "equals": false },
    { "action": "command", "id": "automation/lua/subtitle-grid-join-line-breaks/Record initial" }
  ]
}
