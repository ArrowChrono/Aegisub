{
  "name": "aegisub",
  "version-string": "1.0.0",
  "builtin-baseline": "58950f88544e4637524dbd6a01d0317cf4cb77fc",
  "dependencies": [
    "boost-asio",
    "boost-container",
    "boost-flyweight",
    "boost-gil",
    "boost-interprocess",
    "boost-multiprecision",
    {
      "name": "boost-locale",
      "features": [
        "icu"
      ]
    },
    {
      "name": "boost-regex",
      "features": [
        "icu"
      ]
    },
    "boost-spirit",
    "cli11",
    {
      "name": "fontconfig",
      "platform": "!windows & !osx"
    },
    "gtest",
    "highway",
    "hunspell",
    "icu",
    "libiconv",
    "matroska",
    "pffft",
    "pugixml",
    "stringzilla",
    "uchardet",
    "wxwidgets",
    "xaudio2redist"
  ],
  "features": {
    "bench": {
      "description": "Install Google Benchmark for opt-in local microbenchmarks.",
      "dependencies": [
        "benchmark"
      ]
    },
    "fftw3": {
      "description": "Install FFTW3 files for app-local runtime testing.",
      "dependencies": [
        "fftw3"
      ]
    },
    "fontconfig": {
      "description": "Enable the optional Fontconfig-backed libass font matcher on macOS.",
      "dependencies": [
        {
          "name": "fontconfig",
          "platform": "osx"
        }
      ]
    },
    "drawing-skia": {
      "description": "Install core-only Skia for Lua drawing path operations.",
      "dependencies": [
        {
          "name": "skia",
          "default-features": false
        }
      ]
    },
    "skia-grid": {
      "description": "Install CPU-only Skia and native text dependencies for the subtitle grid.",
      "dependencies": [
        {
          "name": "skia",
          "default-features": false,
          "platform": "windows | osx"
        },
        {
          "name": "skia",
          "default-features": false,
          "features": [
            "fontconfig",
            "freetype",
            "harfbuzz",
            "icu"
          ],
          "platform": "linux | bsd"
        }
      ]
    },
    "skia": {
      "description": "Install full Skia for opt-in GUI rendering features such as video tools.",
      "dependencies": [
        "skia"
      ]
    }
  }
}
